# Run python3 infrastructure/init_env.py to create a private .env with random
# local database credentials. These values are for development only.
INFLUXDB_USERNAME=ptixiaki
INFLUXDB_PASSWORD=
INFLUXDB_TOKEN=
INFLUXDB_ORG=ptixiaki
INFLUXDB_BUCKET=telemetry
# No automatic expiry; choose a documented retention policy before real collection.
INFLUXDB_RETENTION=0s
INFLUXDB_URL=http://127.0.0.1:8086
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC=ptixiaki/equipment-space-01/telemetry
MQTT_CLIENT_ID=ptixiaki-ingestion
DEVICE_ID=esp32-rack-01
DEVICE_OFFLINE_SECONDS=120
API_URL=http://127.0.0.1:8000
